{
  "name": "finstack-api",
  "version": "21.0.0",
  "description": "FinStack ERP — Enterprise SaaS Backend API",
  "main": "app.js",
  "scripts": {
    "start":   "node app.js",
    "dev":     "nodemon app.js",
    "worker":  "node src/jobs/worker.js",
    "test":    "jest --forceExit --coverage",
    "migrate": "node src/utils/migrate.js",
    "seed":    "node src/utils/seed.js",
    "lint":    "eslint src --ext .js"
  },
  "dependencies": {
    "bcryptjs":              "^2.4.3",
    "bullmq":                "^5.12.0",
    "compression":           "^1.7.4",
    "cookie-parser":         "^1.4.6",
    "cors":                  "^2.8.5",
    "dayjs":                 "^1.11.12",
    "dotenv":                "^16.4.5",
    "express":               "^4.19.2",
    "express-async-errors":  "^3.1.1",
    "express-rate-limit":    "^7.3.1",
    "express-validator":     "^7.1.0",
    "helmet":                "^7.1.0",
    "hpp":                   "^0.2.3",
    "ioredis":               "^5.4.1",
    "joi":                   "^17.13.3",
    "jsonwebtoken":          "^9.0.2",
    "morgan":                "^1.10.0",
    "multer":                "^1.4.5-lts.1",
    "nodemailer":            "^6.9.14",
    "pg":                    "^8.12.0",
    "pg-hstore":             "^2.3.4",
    "sequelize":             "^6.37.3",
    "uuid":                  "^10.0.0",
    "winston":               "^3.13.0",
    "xss":                   "^1.0.15"
  },
  "devDependencies": {
    "eslint":    "^8.57.0",
    "jest":      "^29.7.0",
    "nodemon":   "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": { "node": ">=20.0.0" },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
