# ── Node ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment files (NEVER commit secrets) ──────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# ── Next.js ───────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/.next/cache/

# ── Build outputs ─────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log
backend/logs/

# ── Uploads (user files — never commit) ───────────────────────────────────
backend/uploads/
uploads/

# ── Test & coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
jest-results/

# ── OS & Editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Docker ────────────────────────────────────────────────────────────────
nginx/ssl/*.pem
nginx/ssl/*.key

# ── Misc ─────────────────────────────────────────────────────────────────
*.swp
*.swo
.cache/
tmp/
